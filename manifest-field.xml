<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- Data field: opens the garage when the ride timer is STOPPED within the home
         zone. A separate app from HA Control because Connect IQ apps are one type each,
         and only data fields receive the activity timer callbacks. -->
    <iq:application id="d6176b64f1f7417896e51adb2321d2b0"
                   type="datafield"
                   name="@Strings.AppName"
                   entry="HomeFieldApp"
                   launcherIcon="@Drawables.LauncherIcon"
                   minApiLevel="4.0.0">

        <iq:products>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edge840"/>
            <iq:product id="edge540"/>
            <iq:product id="edge550"/>
            <iq:product id="edge850"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="DataFieldAlert"/>
            <!-- Without this, Activity.Info.currentLocation is always null. -->
            <iq:uses-permission id="Positioning"/>
            <!-- Writes the arrival diagnostics into the activity's FIT file. -->
            <iq:uses-permission id="FitContributor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>

    </iq:application>
</iq:manifest>
