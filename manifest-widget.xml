<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- Widget build. Garmin's SDK lists Widget as a supported app type for the
         Edge 1040, and widgets are what the swipe-down loop shows — but whether the
         device actually offers them under System > Widgets has to be tested on the
         device. manifest.xml is the watch-app build that reaches the same code
         through a home screen glance. -->
    <iq:application id="01a33264dbdd471abfc682f1b328037f"
                   type="widget"
                   name="@Strings.AppNameWidget"
                   entry="HaApp"
                   launcherIcon="@Drawables.LauncherIcon"
                   minApiLevel="4.0.0">

        <iq:products>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edge840"/>
            <iq:product id="edge540"/>
            <iq:product id="edge550"/>
            <iq:product id="edge850"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>

    </iq:application>
</iq:manifest>
